# Secrets — never bake into the image
.env

# Local virtual environment
venv/
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Local content directories — these belong in Docker named volumes, not the image
downloads/
uploads/
dashboards/

# Git history
.git/
.gitignore

# Docker files themselves (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
